{
  "system_name": "Academic-OS",
  "version": "5.1.0-STABLE",
  "architecture_type": "Autonomous Multi-Agent Ecosytem",
  "core_philosophy": "Maximum academic rigor through asynchronous multi-model consensus and automated quality auditing.",
  "components": {
    "interface_layer": {
      "path": "bot/bot.py",
      "purpose": "Asynchronous Telegram I/O controller.",
      "capabilities": ["Vision", "Voice Transcription", "PDF Parsing", "Memory Persistence"],
      "technologies": ["telebot-async", "aiohttp"]
    },
    "reasoning_engine": {
      "path": "core/llm_provider.py",
      "role": "Unified Inference Provider",
      "logic": "Dynamic Model Routing",
      "features": ["Deep Chain-of-Thought", "LaTeX-Strict formatting", "SVG/Mermaid visualization"]
    },
    "consensus_layer": {
      "path": "core/consensus.py",
      "function": "Multi-Model Arbitration Engine",
      "process": "Queries multiple high-fidelity models (Gemini, Claude, Llama) and synthesizes the final response via a Supreme Auditor agent."
    },
    "quality_auditor": {
      "path": "core/auditor.py",
      "standard": "Premium Academic Output",
      "metrics": ["HTML Integrity", "Mathematical Consistency", "Visual Clarity", "Logical Flow"]
    },
    "persistence_monitor": {
      "path": "scripts/watchdog.ps1",
      "role": "High-Availability Watchdog",
      "strategy": "Continuous process health monitoring for 24/7 local operation."
    }
  },
  "operational_flow": {
    "routing": "Semantic Router -> (Chat | Academic Task)",
    "processing": "Consensus -> Auditor -> Feedback Loop -> Final Output",
    "delivery": "Rich Text (Telegram) + Compiled PDF Documents"
  },
  "deployment": {
    "cloud": "Render (Web Service Tier)",
    "local": "Python 3.11.x + Watchdog Script",
    "ci_cd": "GitHub Repository Synchronization"
  }
}
